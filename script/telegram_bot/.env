# Скопируй в telegram_bot/.env и заполни
# cp .env.example .env

# Токен, который выдаёт @BotFather при создании бота
TELEGRAM_BOT_TOKEN=8600973215:AAFLRiS8-ccXsmuV71TPnf3HNuOYCYnzZnI

# Chat id, куда бот шлёт уведомления об успехе/ошибках (свой личный чат с ботом или id группы)
TELEGRAM_CHAT_ID=1015497484

# Через запятую: id пользователей, которым разрешено писать боту команды (/run, /status)
# и загружать cookies.json. Свой id можно узнать, написав боту /start.
TELEGRAM_ALLOWED_USER_IDS=1015497484

# Прокси только для запросов к Telegram API (локальный Xray на этом Mac).
# Оставь пустым, если прокси не нужен.
TELEGRAM_PROXY_URL=socks5h://127.0.0.1:11080
