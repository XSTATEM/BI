# Скопируй в telegram_bot/.env и заполни
# cp .env.example .env

# Токен, который выдаёт @BotFather при создании бота
TELEGRAM_BOT_TOKEN=

# Chat id, куда бот шлёт уведомления об успехе/ошибках (свой личный чат с ботом или id группы)
TELEGRAM_CHAT_ID=

# Через запятую: id пользователей, которым разрешено писать боту команды (/run, /status)
# и загружать cookies.json. Свой id можно узнать, написав боту /start.
TELEGRAM_ALLOWED_USER_IDS=

# Прокси только для запросов к Telegram API (например локальный Xray/V2Ray).
# Оставь пустым, если прокси не нужен (Telegram доступен напрямую).
# SOCKS5: socks5h://127.0.0.1:10808   (нужен пакет: pip install "requests[socks]")
# HTTP:   http://127.0.0.1:10809
TELEGRAM_PROXY_URL=
